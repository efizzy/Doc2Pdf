<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Automatically import Efizzy and Efizzy.Doc2Pdf namespaces in projects with ImplicitUsings -->
  <ItemGroup Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'">
    <Using Include="Efizzy" />
    <Using Include="Efizzy.Doc2Pdf" />
  </ItemGroup>
</Project>
